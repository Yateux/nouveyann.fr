# Contact form delivery (Resend).
# Copy this file to .env.local and fill in your values.
# This file is committed: it must never hold a real value.
# None of these may be prefixed NEXT_PUBLIC_: they are secrets.

# Resend API key - https://resend.com/api-keys
RESEND_API_KEY=

# Sender: an address on a domain verified with Resend.
CONTACT_FROM=hello@nouveyann.fr

# Recipient. Optional: falls back to siteConfig.email.
CONTACT_TO=
